    <script>
        let heroIndex = 50;
        let dictatorIndex = 50;
        let studentInfo = { schoolInfo: "", name: "" };
        
        // Student session record for teacher admin and Google Sheets
        let studentRecord = {
            timestamp: "",
            schoolInfo: "",
            name: "",
            heroIndex: 50,
            dictatorIndex: 50,
            mod1QuizPassed: false,
            policiesClassified: 0,
            commentArt: "",
            commentBeethoven: "",
            opinionRussia: "",
            opinionSpain: "",
            opinionBivouac: "",
            quizScore: 0,
            completed: false
        };

        // Load teacher Google Sheets webhook URL from localStorage if configured
        let googleSheetsWebhookUrl = localStorage.getItem('napoleon_sheets_url') || "";

        function startLearningApp() {
            const schoolInfoInput = document.getElementById('student-school-info').value.trim();
            const nameInput = document.getElementById('student-name').value.trim();

            if (!schoolInfoInput || !nameInput) {
                alert("학교/반 번호와 학생 성명을 모두 입력해 주세요!");
                return;
            }

            studentInfo.schoolInfo = schoolInfoInput;
            studentInfo.name = nameInput;
            studentRecord.schoolInfo = schoolInfoInput;
            studentRecord.name = nameInput;
            studentRecord.timestamp = new Date().toLocaleString();

            document.getElementById('student-profile-display').innerText = `학습자: ${schoolInfoInput} ${nameInput}`;
            document.getElementById('badge-congrats-title').innerText = `축하합니다, ${nameInput}님! 형성 평가를 모두 완료했습니다!`;
            document.getElementById('login-modal').classList.add('hidden');
            
            saveRecordLocally();
        }

        function openTeacherModal() {
            document.getElementById('teacher-sheets-url').value = googleSheetsWebhookUrl;
            updateAdminPreview();
            document.getElementById('teacher-modal').classList.remove('hidden');
        }

        function closeTeacherModal() {
            document.getElementById('teacher-modal').classList.add('hidden');
        }

        function saveTeacherSettings() {
            const url = document.getElementById('teacher-sheets-url').value.trim();
            googleSheetsWebhookUrl = url;
            localStorage.setItem('napoleon_sheets_url', url);
            alert("교사 관리자 설정이 저장되었습니다!");
            closeTeacherModal();
        }

        function saveRecordLocally() {
            studentRecord.heroIndex = heroIndex;
            studentRecord.dictatorIndex = dictatorIndex;
            
            let allRecords = JSON.parse(localStorage.getItem('napoleon_student_records') || "[]");
            // Find if student exists and update, or push new
            const existingIdx = allRecords.findIndex(r => r.schoolInfo === studentRecord.schoolInfo && r.name === studentRecord.name);
            if (existingIdx >= 0) {
                allRecords[existingIdx] = studentRecord;
            } else if (studentRecord.name) {
                allRecords.push(studentRecord);
            }
            localStorage.setItem('napoleon_student_records', JSON.stringify(allRecords));
        }

        function updateAdminPreview() {
            let allRecords = JSON.parse(localStorage.getItem('napoleon_student_records') || "[]");
            document.getElementById('admin-student-count').innerText = `${allRecords.length}명 참여`;
            const previewContainer = document.getElementById('admin-data-preview');
            if (allRecords.length === 0) {
                previewContainer.innerHTML = "아직 기록된 학생 데이터가 없습니다.";
                return;
            }
            previewContainer.innerHTML = allRecords.map((r, i) => `
                <div class="bg-stone-900 p-2 rounded border border-stone-800 flex justify-between items-center">
                    <span>${i+1}. [${r.schoolInfo}] ${r.name} (혁명:${r.heroIndex}%, 독재:${r.dictatorIndex}%)</span>
                    <span class="text-amber-400">${r.completed ? '완료' : '진행중'}</span>
                </div>
            `).join('');
        }

        function exportToCSV() {
            let allRecords = JSON.parse(localStorage.getItem('napoleon_student_records') || "[]");
            if (allRecords.length === 0) {
                alert("내보낼 학생 데이터가 없습니다.");
                return;
            }
            let csv = "\uFEFF학교/반,성명,혁명수호지수,독재지수,정책분류수,미술의견,베토벤의견,러시아의견,에스파냐의견,비박의견,퀴즈점수,완료여부,시각\n";
            allRecords.forEach(r => {
                csv += `"${r.schoolInfo}","${r.name}",${r.heroIndex}%,${r.dictatorIndex}%,${r.policiesClassified}/6,"${(r.commentArt||'').replace(/"/g,'""')}","${(r.commentBeethoven||'').replace(/"/g,'""')}","${(r.opinionRussia||'').replace(/"/g,'""')}","${(r.opinionSpain||'').replace(/"/g,'""')}","${(r.opinionBivouac||'').replace(/"/g,'""')}",${r.quizScore},${r.completed ? 'O' : 'X'},"${r.timestamp}"\n`;
            });
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `나폴레옹학습결과_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
        }

        async function syncToGoogleSheets() {
            if (!googleSheetsWebhookUrl) {
                alert("먼저 구글 Apps Script 웹앱 연동 URL을 입력하고 저장해 주세요!");
                return;
            }
            let allRecords = JSON.parse(localStorage.getItem('napoleon_student_records') || "[]");
            if (allRecords.length === 0) {
                alert("전송할 학생 데이터가 없습니다.");
                return;
            }

            try {
                // Send records to Google Sheets web app webhook
                const response = await fetch(googleSheetsWebhookUrl, {
                    method: 'POST',
                    mode: 'no-cors', // standard for GAS web apps
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ records: allRecords })
                });
                alert("구글 시트로 데이터 전송 요청이 완료되었습니다! (구글 시트에서 행이 추가되었는지 확인하세요)");
            } catch (err) {
                console.error(err);
                alert("구글 시트 전송 중 오류가 발생했습니다. 웹 앱 URL 설정을 다시 확인해 주세요.");
            }
        }

