        function saveUserComment(type) {
            const val = document.getElementById(`comment-${type}`).value.trim();
            const msg = document.getElementById(`save-msg-${type}`);
            if (val) {
                if (type === 'art') studentRecord.commentArt = val;
                if (type === 'beethoven') studentRecord.commentBeethoven = val;
                saveRecordLocally();

                msg.classList.remove('hidden');
                updateIndices(3, 3);
                setTimeout(() => msg.classList.add('hidden'), 3000);
            } else {
                alert("의견 내용을 입력해 주세요.");
            }
        }

        // Module 4 Campaign Opinion Saving (No preset examples)
        function saveCampaignOpinion(type) {
            const val = document.getElementById(`opinion-${type}`).value.trim();
            const msg = document.getElementById(`msg-${type}`);
            if (val) {
                if (type === 'russia') studentRecord.opinionRussia = val;
                if (type === 'spain') studentRecord.opinionSpain = val;
                if (type === 'bivouac') studentRecord.opinionBivouac = val;
                saveRecordLocally();

                msg.classList.remove('hidden');
                updateIndices(3, 3);
                setTimeout(() => msg.classList.add('hidden'), 3000);
            } else {
                alert("의견 내용을 입력해 주세요.");
            }
        }

        // Module 5 Gemini AI API Integration
        async function sendChatMessage() {
            const input = document.getElementById('user-chat-input');
            const text = input.value.trim();
            if (!text) return;

            const container = document.getElementById('chat-container');
            
            // Append User Message
            const userMsg = document.createElement('div');
            userMsg.className = "bg-blue-950/60 p-3 rounded-lg max-w-[80%] text-xs text-stone-200 self-end border border-blue-900";
            userMsg.innerHTML = `👤 <strong>${studentInfo.name || '학생'}:</strong> ${text}`;
            container.appendChild(userMsg);
            input.value = '';
            container.scrollTop = container.scrollHeight;

            // Append Loading AI Response
            const aiMsg = document.createElement('div');
            aiMsg.className = "bg-stone-800 p-3 rounded-lg max-w-[80%] text-xs text-stone-300 self-start border border-stone-700";
            aiMsg.innerHTML = `🏛️ <strong>역사 재판소 판사:</strong> 증거를 검토 중입니다...`;
            container.appendChild(aiMsg);
            container.scrollTop = container.scrollHeight;

            const systemPrompt = "당신은 '역사 재판소의 판사'입니다. 학습자가 나폴레옹의 정책을 평가할 때, 소스 컨텍스트의 구체적 사례(예: 아이티 학살, 투표 조작 등)를 언급하면 '날카로운 증거 제시입니다'라고 칭찬하십시오. 만약 학습자가 한쪽 측면만 옹호한다면 반대편의 역사적 팩트를 제시하며 비판적 사고를 유도하십시오. 답변은 항상 중학교 2학년 수준의 친절하고 명확한 문체를 유지하십시오.";
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: text }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            try {
                let response = null;
                for (let attempt = 0; attempt < 3; attempt++) {
                    try {
                        response = await fetch(apiUrl, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        if (response.ok) break;
                    } catch (e) {
                        await new Promise(r => setTimeout(r, Math.pow(2, attempt) * 1000));
                    }
                }

                if (response && response.ok) {
                    const result = await response.json();
                    const candidate = result.candidates?.[0];
                    if (candidate && candidate.content?.parts?.[0]?.text) {
                        aiMsg.innerHTML = `🏛️ <strong>역사 재판소 판사:</strong> ${candidate.content.parts[0].text}`;
                    } else {
                        aiMsg.innerHTML = `🏛️ <strong>역사 재판소 판사:</strong> 흥미로운 의견입니다만, 아이티 학살이나 나폴레옹 법전 같은 구체적 팩트를 함께 고려해 볼까요?`;
                    }
                } else {
                    aiMsg.innerHTML = `🏛️ <strong>역사 재판소 판사:</strong> 훌륭한 역사적 시각입니다! 나폴레옹의 영웅적 측면과 독재적 양면성을 모두 검토해 보세요.`;
                }
            } catch (err) {
                aiMsg.innerHTML = `🏛️ <strong>역사 재판소 판사:</strong> 날카로운 통찰이네요! 프랑스 혁명 정신과 독재 사이의 균형을 잘 살펴보았습니다.`;
            }
            container.scrollTop = container.scrollHeight;
        }

