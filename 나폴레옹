            {
                type: "text",
                q: "[주관식 6] 다비드의 명화 '알프스 산맥을 넘는 나폴레옹'에서 사실과 다르게 미화된 ‘이동 수단’을 쓰시오.",
                expected: "노새"
            },
            {
                type: "text",
                q: "[주관식 7] '조끼 속 오른손' 포즈가 조선의 개화파 인물(김옥균 등)에게 미친 영향은?",
                expected: "근대화론자"
            },
            {
                type: "essay",
                q: "[서술형 8] 나폴레옹이 아이티 식민지에서 저지른 반인권적 만행을 기술하시오.",
                hint: "노예제 부활, 12세 미만 제외 학살, 수중 처형 등의 키워드가 포함되어야 합니다."
            },
            {
                type: "essay",
                q: "[서술형 9] 에스파냐 민중들이 나폴레옹 군대에 저항한 이유를 '민족주의' 관점에서 쓰시오.",
                hint: "주권 침해, 민중 학살, 외세 침략에 맞선 민족적 자각 등의 내용이 포함되어야 합니다."
            },
            {
                type: "essay",
                q: "[서술형 10] 베토벤이 나폴레옹에게 실망하여 '영웅 교향곡'의 헌사를 찢은 이유는?",
                hint: "혁명 정신 저버림, 황제 즉위, 독재자 변질 등의 내용이 포함되어야 합니다."
            }
        ];

        let currentQuiz = 0;
        let correctQuizCount = 0;

        function loadQuiz() {
            if (currentQuiz >= quizData.length) {
                document.getElementById('quiz-box').classList.add('hidden');
                document.getElementById('badge-box').classList.remove('hidden');
                studentRecord.completed = true;
                studentRecord.quizScore = correctQuizCount;
                saveRecordLocally();
                return;
            }
            const qObj = quizData[currentQuiz];
            document.getElementById('quiz-progress').innerText = `문제 ${currentQuiz + 1} / ${quizData.length}`;
            document.getElementById('quiz-question').innerText = qObj.q;
            
            const optContainer = document.getElementById('quiz-options');
            const textContainer = document.getElementById('quiz-text-input-container');
            const nextBtn = document.getElementById('next-quiz-btn');
            const fb = document.getElementById('quiz-feedback');
            
            optContainer.innerHTML = '';
            textContainer.classList.add('hidden');
            nextBtn.classList.add('hidden');
            fb.classList.add('hidden');

            if (qObj.type === 'mc') {
                optContainer.classList.remove('hidden');
                qObj.options.forEach((opt, idx) => {
                    const btn = document.createElement('button');
                    btn.className = "p-3 rounded-xl bg-stone-800 hover:bg-stone-700 text-xs text-stone-200 border border-stone-700 text-left transition font-bold";
                    btn.innerText = opt;
                    btn.onclick = () => checkQuizMC(idx, qObj.answer);
                    optContainer.appendChild(btn);
                });
            } else {
                optContainer.classList.add('hidden');
                textContainer.classList.remove('hidden');
                document.getElementById('quiz-user-input').value = '';
            }
        }

        function checkQuizMC(selected, correct) {
            const fb = document.getElementById('quiz-feedback');
            fb.classList.remove('hidden');
            if (selected === correct) {
                correctQuizCount++;
                fb.className = "text-sm font-medium p-3 rounded-lg bg-green-950/40 text-green-300 border border-green-800";
                fb.innerHTML = "🎉 정답입니다! 역사적 사실을 정확하게 이해하셨네요.";
                updateIndices(5, 0);
                document.getElementById('next-quiz-btn').classList.remove('hidden');
            } else {
                fb.className = "text-sm font-medium p-3 rounded-lg bg-red-950/40 text-red-300 border border-red-800";
                fb.innerHTML = "❌ 아쉽습니다. 다시 학습 모듈 내용을 확인해 보세요!";
            }
        }

        function submitTextAnswer() {
            const val = document.getElementById('quiz-user-input').value.trim();
            const fb = document.getElementById('quiz-feedback');
            fb.classList.remove('hidden');
            if (val.length > 2) {
                correctQuizCount++;
                fb.className = "text-sm font-medium p-3 rounded-lg bg-green-950/40 text-green-300 border border-green-800";
                fb.innerHTML = "🎉 훌륭한 서술 및 주관식 답변입니다! 역사적 사실과 비판적 사고가 잘 드러났습니다.";
                updateIndices(5, 5);
                document.getElementById('next-quiz-btn').classList.remove('hidden');
            } else {
                fb.className = "text-sm font-medium p-3 rounded-lg bg-amber-950/40 text-amber-300 border border-amber-800";
                fb.innerHTML = "⚠️ 답변이 너무 짧습니다. 좀 더 구체적인 역사적 배경이나 키워드를 포함하여 작성해 보세요.";
            }
        }

        function nextQuizItem() {
            currentQuiz++;
            loadQuiz();
        }

        // Initialize on load
        window.onload = () => {
            loadMod1Quiz();
            loadQuiz();
        };
    </script>
</body>
</html>
