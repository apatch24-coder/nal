        }

        // Module 1 Choice Handler
        function handleMod1Choice(type) {
            const fb = document.getElementById('mod1-feedback');
            fb.classList.remove('hidden');
            if (type === 'hero') {
                updateIndices(10, -10);
                fb.innerHTML = "✅ <strong>원칙 준수 선택:</strong> 민주적 가치를 존중하여 독재 지수가 하락하고 혁명 수호 지수가 상승했습니다. 하지만 실제 역사 속 나폴레옹은 권력 확립을 택했습니다.";
            } else {
                updateIndices(-15, 20);
                fb.innerHTML = "👑 <strong>권력 장악 선택:</strong> 역사적 팩트대로 투표 수치(육군 12만➔40만)를 조작하여 황제권을 공고히 하였습니다. 독재 지수가 크게 상승했습니다!";
            }
        }

        // Module 2 Policy Classification (6 items)
        let classifiedCount = 0;
        const classifiedSet = new Set();
        function classifyPolicy(policyKey, view) {
            const status = document.getElementById('mod2-status');
            if (!classifiedSet.has(policyKey)) {
                classifiedSet.add(policyKey);
                classifiedCount++;
                studentRecord.policiesClassified = classifiedCount;
                saveRecordLocally();
            }
            if (view === 'hero') {
                updateIndices(4, 0);
            } else {
                updateIndices(0, 4);
            }
            status.innerHTML = `✅ 정책 분류 진행 중 (${classifiedCount}/6 완료)! 영웅적 업적과 독재적 그림자의 양면성을 모두 확인해 보세요.`;
            if (classifiedCount === 6) {
                status.innerHTML = `🎉 6대 핵심 정책 분류를 모두 완료했습니다! 영웅과 독재자의 두 얼굴을 완벽하게 파악하셨습니다.`;
            }
        }

